<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sheryians Backend</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900  pt-20">
        <div class="form px-10 text-white">
            <form action="/create" method="post">
                <input class="block px-5 w-full py-2 bg-zinc-800  outline-none" type="text" placeholder="Title Goes" name="title"/>
                <textarea class="block mt-2 w-full px-5 py-2  text-white outline-none resize-none bg-zinc-800" placeholder="Write Description here" name="details"></textarea>
                <input class="mt-4 w-half py-2 bg-blue-600 hover:bg-blue-700 rounded-md cursor-pointer font-semibold transition duration-200" type="submit" value="Create Task" />
            </form>
        </div>

        <div class="tasks p-10 flex gap-5 flex-wrap">

            <% if(files.length> 0){ %>

                <% files.forEach((val)=>{ %>

                    <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
                        <h1 class="text-white text-2xl tracking-tighter break-all">
                            <%= val %>
                        </h1>
                        <a href="" class="text-blue-500 inline-block mt-3">Read More</a>
                    </div>

                    <% }) %>

                        <% } else { %>

                            <h1 class="text-white text-zinc-600">No Task Added Yet</h1>

                            <% } %>

        </div>

    </div>
    <script src="/javaScript/script.js"></script>
</body>

</html>